<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
    <title>Author List</title>
</head>
<body class="bg-night">
    <header class="bg-jet center-div">
        <h1 class="txt-white header-font">Authors</h1>
    </header>

    <%-include('partials/nav.ejs')%>

    <% for (let author of authors)  { %>
        <main>
            <p class="txt-white primary-txt"><a class="primary-txt" href="/editAuthor?authorId=<%= author.authorId %>">Update</a> <%= author.firstName %> <%= author.lastName %></p>
        </main>
    <% } %>
</body>
</html>
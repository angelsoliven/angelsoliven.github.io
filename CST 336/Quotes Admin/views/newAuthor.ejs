<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Author</title>
</head>
<body>
    <h1>New Author</h1>
    <form action="/insertAuthor" method="post">
        <label for="firstNameInput"> First Name </label>
        <input type="text" name="firstName" id="firstNameInput" />

        <br>

        <label for="lastNameInput"> Last Name </label>
        <input type="text" name="lastName" id="lastNameInput" />

        <br>

        <label for="dodInput">DOD</label>
        <input type="date" name="dod" id="dodInput">

        <br>

        <label for="dobInput">DOB</label>
        <input type="date" name="dob" id="dobInput">

        <br>

        <label for="genderInput">Gender</label>
        <input type="text" name="gender" id="genderInput">

        <br>

        <label for="professionInput">Profession</label>
        <input type="text" name="profession" id="professionInput">

        <br>

        <label for="countryInput">Country</label>
        <input type="text" name="country" id="countryInput">

        <br>

        <label for="portraitInput">Portrait</label>
        <input type="text" name="portrait" id="portraitInput">

        <br>

        <label for="bioInput">Biography</label>
        <input type="text" name="bio" id="bioInput">

        <button>Create</button>
    </form>
</body>
</html>
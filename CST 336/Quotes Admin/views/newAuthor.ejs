<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
        <title>New Author</title>
</head>

<body class="bg-night">
    <header class="bg-jet center-div">
        <h1 class="txt-white header-font">New Author</h1>
    </header>

    <%-include('partials/nav.ejs')%>

        <form class="center-div" action="/insertAuthor" method="post">
            <div>
                <!-- Checks if there is a formErrors object 
                and if it has an entry for the user field  -->
                <div>
                    <% if (formErrors.length> 0) { %>
                        <% for (let err of formErrors) { %>
                            <p class="txt-white primary-txt"> <span class="form-error"> <%=err%> </span> </p>
                        <% } %>
                    <% } %>
                </div>

                <div>
                    <label for="firstNameInput" class="txt-white primary-txt"> First Name </label>
                    <input class="primary-txt" type="text" name="firstName" id="firstNameInput" />
                </div>

                <div>
                    <label for="lastNameInput" class="txt-white primary-txt"> Last Name </label>
                    <input class="primary-txt" type="text" name="lastName" id="lastNameInput" />
                </div>

                <div>
                    <label for="dodInput" class="txt-white primary-txt">DOD</label>
                    <input class="primary-txt" type="date" name="dod" id="dodInput">
                </div>

                <div>
                    <label for="dobInput" class="txt-white primary-txt">DOB</label>
                    <input class="primary-txt" type="date" name="dob" id="dobInput">
                </div>

                <div>
                    <label for="genderInput" class="txt-white primary-txt">Gender</label>
                    <input class="primary-txt" type="text" name="gender" id="genderInput">
                </div>

                <div>
                    <label for="professionInput" class="txt-white primary-txt">Profession</label>
                    <input class="primary-txt" type="text" name="profession" id="professionInput">
                </div>

                <div>
                    <label for="countryInput" class="txt-white primary-txt">Country</label>
                    <input class="primary-txt" type="text" name="country" id="countryInput">
                </div>

                <div>
                    <label for="portraitInput" class="txt-white primary-txt">Portrait</label>
                    <input class="primary-txt" type="text" name="portrait" id="portraitInput">
                </div>

                <div>
                    <label for="bioInput" class="txt-white primary-txt">Biography</label>
                    <input class="primary-txt" type="text" name="bio" id="bioInput">
                </div>

                <div>
                    <button type="button" class="btn btn-primary primary-txt">Create</button>
                </div>
            </div>
        </form>
</body>

</html>
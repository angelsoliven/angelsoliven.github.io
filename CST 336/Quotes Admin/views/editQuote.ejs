<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
    <title>Edit Quote</title>
</head>

<body class="bg-night">
    <header class="bg-jet center-div">
        <h1 class="txt-white header-font">Edit Quote</h1>
    </header>

    <%-include('partials/nav.ejs')%>

    <!-- Where you type in the quote -->
    <form class="center-div" action="/updateQuote" method="post">
        <div>
            <!-- This keeps track fo the quote Id we're editing so
             we can submit this when we click update -->
            <input type="hidden" name="quoteId" value="<%= formObject.quoteId %>">

            <!-- Checks if there is a formErrors object 
                and if it has an entry for the user field  -->
            <div>
                <% if (formErrors.length > 0) { %>
                    <% for (let err of formErrors) { %>
                        <p class="txt-white primary-txt"> <span class="form-error"><%=err%></span> </p>
                    <%}%>
                <% } %>
            </div>

            <div>
                <label class="txt-white primary-txt" for="quoteInput">Quote</label>
                <!-- The "value" being set fills in the text box with the current quote -->
                <input class="primary-txt" type="text" name="quote" id="quoteInput" value="<%= formObject.quote %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="authorInput">Author</label>
                <!-- The if statement is to make sure the correct author is selected by default -->
                <select class="primary-txt" type="text" name="authorId" id="authorInput">
                    <% for (let author of formData.authors) { %>
                        <% if (author.authorId == formObject.authorId) { %>
                            <option class="primary-txt" value="<%= author.authorId %>" selected><%= author.firstName %> <%=author.lastName%></option>
                        <% } else { %>
                            <option class="primary-txt" value="<%= author.authorId %>"><%= author.firstName %> <%=author.lastName%></option>
                        <% } %>
                    <% } %>
                </select>
            </div>

            <div>
                <label class="txt-white primary-txt" for="categoryInput">Categories</label>
                <select class="primary-txt" type="text" name="category" id="categoryInput">
                    <% for (let category of formData.categories) { %>
                        <% if (category.category == formObject.category) { %>
                            <option class="primary-txt" value="<%=category.category%>" selected><%=category.category%></option>
                        <% } else { %>
                            <option class="primary-txt" value="<%=category.category%>"><%=category.category%></option>
                        <% } %>
                    <% } %>
                </select>
            </div>

            <div>
                <label class="primary-txt txt-white" for="likesInput">Likes</label>
                <input class="primary-txt" type="number" name="likes" id="likesInput" value="<%=formObject.likes %>">
            </div>

            <div>
                <button type="submit" class="btn btn-primary primary-txt">Edit</button>
            </div>
        </div>
    </form>
</body>

</html>
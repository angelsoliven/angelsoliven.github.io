<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
    <title>Add Quote</title>
</head>

<body>
    <h1>New Quote</h1>
    <%-include('partials/nav.ejs')%>
    <!-- Where you type in the quote -->
    <form action="/insertQuote" method="post">
        <!-- Checks if there is a formErrors object 
             and if it has an entry for the user field  -->
        <% if (formErrors.length > 0) { %>
            <% for (let err of formErrors) { %>
                <span class="form-error"><%=err%></span> 
                <br>
            <%}%>
        <% } %>

        <label for="quoteInput">Quote</label>
        <input type="text" name="quote" id="quoteInput">

        <br>

        <label for="authorInput">Author</label>
        <!-- The if statement is to make sure the correct author is selected by default -->
        <select type="text" name="authorId" id="authorInput">
            <% for (let author of formData.authors) { %>
                    <option value="<%= author.authorId %>"><%= author.firstName %> <%=author.lastName%></option>
            <% } %>
        </select>

        <br>

        <label for="categoryInput">Categories</label>
        <select type="text" name="category" id="categoryInput">
            <% for (let category of formData.categories) { %>
                    <option value="<%=category.category%>"><%=category.category%></option>
            <% } %>
        </select>

        <br>

        <label for="likesInput"> Likes </label>
        <input type="number" name="likes" id="likesInput" />

        <button>Create</button>
    </form>
</body>

</html>
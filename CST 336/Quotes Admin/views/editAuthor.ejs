<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
    <title>Edit Author</title>
</head>
<body>
    <h1>Edit author</h1>
    <%-include('partials/nav.ejs')%>

    <form action="/updateAuthor" method="post">

        <!-- This keeps track of the authorId we're editing so
             we can submit this when we click update -->
        <input type="hidden" name="authorId" value="<%= formObject.authorId %>">

        <!-- Checks if there is a formErrors object 
             and if it has an entry for the user field  -->
        <% if (formErrors.length > 0) { %>
            <% for (let err of formErrors) { %>
                <span class="form-error"><%=err%></span> 
                <br>
            <%}%>
        <% } %>

        <label for="firstNameInput">First Name</label>
        <input type="text" name="authorFirst" id="firstNameInput" value="<%= formObject.firstName %>">

        <br>

        <label for="lastNameInput">Last Name</label>
        <input type="text" name="authorLast" id="lastNameInput" value="<%= formObject.lastName %>">

        <br>

        <label for="dodInput">DOD</label>
        <input type="date" name="dod" id="dodInput" value="<%= formObject.dod %>">

        <br>

        <label for="dobInput">DOB</label>
        <input type="date" name="dob" id="dobInput" value="<%= formObject.dob %>">

        <br>

        <label for="genderInput">Gender</label>
        <input type="text" name="gender" id="genderInput" value="<%= formObject.gender %>">

        <br>

        <label for="professionInput">Profession</label>
        <input type="text" name="profession" id="professionInput" value="<%= formObject.profession %>">

        <br>

        <label for="countryInput">Country</label>
        <input type="text" name="country" id="countryInput" value="<%= formObject.country %>">

        <br>

        <label for="portraitInput">Portrait</label>
        <input type="text" name="portrait" id="portraitInput" value="<%= formObject.portrait %>">

        <br>

        <label for="bioInput">Biography</label>
        <input type="text" name="bio" id="bioInput" value="<%= formObject.biography %>">

        <button>Update</button>
    </form>
</body>
</html>
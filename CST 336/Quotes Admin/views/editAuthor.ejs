<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%-include('partials/includes.ejs')%>
    <title>Edit Author</title>
</head>
<body class="bg-night">
    <header class="bg-jet center-div">
        <h1 class="txt-white header-font">Edit Author</h1>
    </header>

    <%-include('partials/nav.ejs')%>

    <form class="center-div" action="/updateAuthor" method="post">
        <div>
            <!-- This keeps track of the authorId we're editing so
             we can submit this when we click update -->
            <input type="hidden" name="authorId" value="<%= formObject.authorId %>">

            <!-- Checks if there is a formErrors object 
                and if it has an entry for the user field  -->
            <div>
                <% if (formErrors.length > 0) { %>
                    <% for (let err of formErrors) { %>
                        <p class="txt-white primary-txt"> <span class="form-error"><%=err%></span> </p>
                    <%}%>
                <% } %>
            </div>

            <div>
                <label class="txt-white primary-txt" for="firstNameInput">First Name</label>
                <input class="primary-txt" type="text" name="authorFirst" id="firstNameInput" value="<%= formObject.firstName %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="lastNameInput">Last Name</label>
                <input class="primary-txt" type="text" name="authorLast" id="lastNameInput" value="<%= formObject.lastName %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="dodInput">DOD</label>
                <input class="primary-txt" type="date" name="dod" id="dodInput" value="<%= formObject.dod %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="dobInput">DOB</label>
                <input class="primary-txt" type="date" name="dob" id="dobInput" value="<%= formObject.dob %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="genderInput">Gender</label>
                <input class="primary-txt" type="text" name="gender" id="genderInput" value="<%= formObject.gender %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="professionInput">Profession</label>
                <input class="primary-txt" type="text" name="profession" id="professionInput" value="<%= formObject.profession %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="countryInput">Country</label>
                <input class="primary-txt" type="text" name="country" id="countryInput" value="<%= formObject.country %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="portraitInput">Portrait</label>
                <input class="primary-txt" type="text" name="portrait" id="portraitInput" value="<%= formObject.portrait %>">
            </div>

            <div>
                <label class="txt-white primary-txt" for="bioInput">Biography</label>
                <input class="primary-txt" type="text" name="bio" id="bioInput" value="<%= formObject.biography %>">
            </div>

            <div>
                <button type="button" class="btn btn-primary primary-txt">Edit</button>
            </div>
        </div>
    </form>
</body>
</html>
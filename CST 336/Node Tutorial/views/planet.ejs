<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planets!</title>

    <%-include('partials/includes.ejs')%>
    <%-include('partials/style.ejs')%>
</head>

<body>
    <header> <h1 id="header-title" class="header-text text-center text-color darkest-blue-bg"> <%=name%> </h1> </header>

    <%-include('partials/nav.ejs')%>

    <main id="main-section" class="img-display mid-blue-bg">
        <div> <img class="planet-dimensions" src="<%=planetData.image%>" /> </div>

        <div class="info-section-1">
            <div id="planet-description"> <p class="text-color primary-text"> <%=planetData.description%> </p> </div>
            <div>
                <div> <p class="text-color primary-text"> Distance from Sun: <%=planetData.distanceFromSun%> </p> </div>
                <div> <p class="text-color primary-text"> Year Length: <%=planetData.yearLength%> </p> </div>
                <div> <p class="text-color primary-text"> Radius: <%=planetData.radius%> </p> </div>
                <div> <p class="text-color primary-text"> One Earth Day Equivalent: <%=planetData.oneEarthDay%> </p> </div>
                <div> <p class="text-color primary-text"> Number of Moons: <%=planetData.moons%> </p> </div>
                <div> <a class="text-color primary-text" href=<%=planetData.websiteLink%>> Information Link </a> </div>
            </div>
        </div>
    </main>

    <%-include('partials/footer.ejs')%>
</body>

</html>
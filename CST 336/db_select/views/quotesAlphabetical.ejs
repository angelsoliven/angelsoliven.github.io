<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alphabetical Quotes</title>
</head>
<body>
    <header><h1>Alphabetical Quotes</h1></header>

    <% for (let row of rows) { %>
        <p> <%=row.quote%> - <%=row.firstName%> <%=row.lastName%> </p>
    <% } %>
</body>
</html>